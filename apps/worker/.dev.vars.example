# Copy this file to .dev.vars for local worker runtime.
# Do not commit .dev.vars.
# Public vars are defined in wrangler.jsonc `vars` and do not need to be duplicated here:
#  ACCESS_TOKEN_TTL_SECONDS, APP_ENV, AUTH_ALLOW_INSECURE_TEST_TOKENS, AUTH_AUDIENCE,
#  AUTH_ISSUER, OPENAI_COMPAT_BASE_URL, OPENAI_COMPAT_MODEL, RATE_LIMIT_ENABLED,
#  RATE_LIMIT_MAX_REQUESTS, REFRESH_TOKEN_TTL_SECONDS, TELEGRAM_BOT_DEEP_LINK_URL,
#  TELEGRAM_BOT_TMA_URL
# This file only contains secrets and bindings not in wrangler vars.
# To override any public var locally (e.g. APP_ENV=local), add it to your .dev.vars.

# Internal API key for admin/internal migration routes
INTERNAL_API_KEY="replace-with-internal-api-key"

# Firebase identity provider settings
FIREBASE_PROJECT_ID="household-finance-local"
FIREBASE_JWKS_URL="https://www.googleapis.com/service_accounts/v1/jwk/securetoken@system.gserviceaccount.com"

# Telegram identity provider settings
TELEGRAM_BOT_TOKEN="replace-with-telegram-bot-token"
# Optional freshness window for Telegram initData (default 3600 seconds)
# TELEGRAM_FRESHNESS_WINDOW_SECONDS="3600"
# Required webhook secret for Telegram bot (X-Telegram-Bot-Api-Secret-Token verification)
TELEGRAM_BOT_WEBHOOK_SECRET="replace-with-webhook-secret"

# Secrets
AUTH_JWT_SECRET="replace-with-local-secret"
AUTH_REFRESH_TOKEN_PEPPER="replace-with-local-pepper"
INVITATION_TOKEN_PEPPER="replace-with-invitation-pepper"

# Cloudinary upload signing
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Optional upload policy overrides
# CLOUDINARY_MAX_IMAGE_BYTES="10485760"
# CLOUDINARY_MAX_VIDEO_BYTES="104857600"
# CLOUDINARY_ALLOWED_IMAGE_MIME_TYPES="image/jpeg,image/png,image/webp"
# CLOUDINARY_ALLOWED_VIDEO_MIME_TYPES="video/mp4,video/webm"

# OpenAI-compatible AI expense parser (secret)
OPENAI_COMPAT_API_KEY="replace-with-your-api-key"
# Optional AI parser timeout in ms (default 60000 = 60s) — configurable via OPENAI_COMPAT_TIMEOUT_MS
OPENAI_COMPAT_TIMEOUT_MS="60000"
